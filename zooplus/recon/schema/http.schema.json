{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "http_id",
    "host_id",
    "url",
    "scheme",
    "host",
    "port",
    "status_code"
  ],
  "properties": {
    "http_id": {
      "type": "string",
      "pattern": "^http_[0-9]+$"
    },
    "host_id": {
      "type": "string",
      "pattern": "^host_[0-9]+$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "scheme": {
      "type": "string",
      "enum": [
        "http",
        "https"
      ]
    },
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "status_code": {
      "type": "integer"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "server": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_length": {
      "type": [
        "integer",
        "null"
      ]
    },
    "response_time_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "redirect_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_url": {
      "type": "string"
    },
    "webserver": {
      "type": [
        "string",
        "null"
      ]
    },
    "cdn": {
      "type": [
        "string",
        "null"
      ]
    },
    "tls_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "tls_cipher": {
      "type": [
        "string",
        "null"
      ]
    },
    "cert_cn": {
      "type": [
        "string",
        "null"
      ]
    },
    "cert_san": {
      "type": [
        "string",
        "null"
      ]
    },
    "ips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string"
    },
    "powered_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "hsts": {
      "type": [
        "string",
        "null"
      ]
    },
    "cache": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}